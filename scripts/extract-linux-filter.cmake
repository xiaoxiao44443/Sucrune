# Extract the actual generator, not a copied implementation, for the BPF model.
if(NOT DEFINED SOURCE OR NOT DEFINED OUTPUT)
    message(FATAL_ERROR "SOURCE and OUTPUT are required.")
endif()
file(READ "${SOURCE}" source_text)
string(REGEX MATCHALL "static size_t filter_range\\(" starts "${source_text}")
string(REGEX MATCHALL "static int guarded\\(" ends "${source_text}")
list(LENGTH starts start_count)
list(LENGTH ends end_count)
if(NOT start_count EQUAL 1 OR NOT end_count EQUAL 1)
    message(FATAL_ERROR "Cannot uniquely identify the real Linux filter generator.")
endif()
string(FIND "${source_text}" "static size_t filter_range(" start)
string(FIND "${source_text}" "static int guarded(" end)
if(end LESS_EQUAL start)
    message(FATAL_ERROR "Linux filter source markers are out of order.")
endif()
string(REGEX MATCH "(^|\n)#define SHELL_TAG[^\r\n]+" tag "${source_text}")
if(tag STREQUAL "")
    message(FATAL_ERROR "Cannot identify the actual seccomp tag.")
endif()
math(EXPR length "${end} - ${start}")
string(SUBSTRING "${source_text}" ${start} ${length} generator)
string(FIND "${generator}" "static int linux_filter(" filter_start)
if(filter_start LESS 0)
    message(FATAL_ERROR "The extracted range lacks linux_filter.")
endif()
file(WRITE "${OUTPUT}" "/* Generated from shell_runtime.c; do not edit. */\n${tag}\n${generator}")
